#!/bin/bash
set -eo pipefail

# Создаем директорию для сокета
mkdir -p /run/podman
chmod 755 /run/podman

# Проверяем, существует ли уже рабочий сокет
if [ -S /run/podman/podman.sock ]; then
    echo "🟢 Podman socket already exists"
else
    # Запускаем Podman API socket в фоне
    echo "🟡 Starting Podman API socket..."
    podman system service --time=30 unix:///run/podman/podman.sock &

    # Ждем создания сокета (максимум 10 секунд)
    for i in {1..10}; do
        if [ -S /run/podman/podman.sock ]; then
            echo "🟢 Podman socket ready"
            break
        fi
        sleep 1
        [ $i -eq 10 ] && echo "🔴 Failed to start Podman socket" && exit 1
    done
fi
[ -e /run/podman/podman.sock ] && [ ! -e /var/run/docker.sock ] && ln -s /run/podman/podman.sock /var/run/docker.sock || true
